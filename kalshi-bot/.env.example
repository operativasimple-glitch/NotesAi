# Copia este archivo como .env y rellénalo. NUNCA lo subas a GitHub.

# demo = dinero ficticio (https://demo.kalshi.co) | prod = dinero real (https://kalshi.com)
# Las API keys de demo solo funcionan en demo y las de prod solo en prod.
KALSHI_ENV=demo

# ID de tu API key (lo ves en Kalshi al crearla)
KALSHI_API_KEY_ID=

# Ruta al archivo .pem que descargaste al crear la key (relativa a esta carpeta)
KALSHI_PRIVATE_KEY_PATH=./kalshi-key.pem

# Alternativa para servidores: el contenido del PEM en una línea, con \n en los saltos
# KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- Panel web (python -m kalshi_bot web) ---
# Contraseña para entrar al panel (8 caracteres o más; mejor 12+)
DASHBOARD_PASSWORD=
# Carpeta donde el panel guarda ajustes, credenciales y registros (opcional)
# KALSHI_BOT_DATA_DIR=./data
