//@version=5
// PSF A · Dip en tendencia · v2
// Gráfico DIARIO de US500, US30 o US100 (feed OANDA).
// Señal: precio por encima de la media de 200 y RSI(2) por debajo de 10.
// Entrada: antes del cierre (3:50-3:58 pm Nueva York). SL: 2,5 x ATR(14).
// TP: primer cierre por encima de la media de 5, o a las 7 sesiones.
// Alertas: UNA alerta con «Cualquier llamada a la función alert()». El escáner vigila los tres índices.
indicator("PSF A · Dip en tendencia", shorttitle="PSF A", overlay=true, max_labels_count=300, max_lines_count=300, max_boxes_count=150)

// ───────── Parámetros
grpR = "Reglas"
lenTrend = input.int(200, "Media de tendencia", minval=20, group=grpR)
lenExit  = input.int(5, "Media de salida (TP)", minval=2, group=grpR)
lenRsi   = input.int(2, "RSI periodos", minval=2, group=grpR)
rsiMax   = input.float(10.0, "RSI por debajo de", minval=1.0, maxval=50.0, group=grpR)
lenAtr   = input.int(14, "ATR periodos", minval=2, group=grpR)
atrMult  = input.float(2.5, "SL = ATR x", minval=0.5, step=0.1, group=grpR)
maxDays  = input.int(7, "Sesiones máximas", minval=1, group=grpR)

grpW = "Ventana de alertas (hora de Nueva York)"
winFrom = input.int(1545, "Desde (HHMM)", minval=0, maxval=2359, group=grpW)
winTo   = input.int(1558, "Hasta (HHMM)", minval=0, maxval=2359, group=grpW)

grpS = "Escáner"
sym1 = input.symbol("OANDA:SPX500USD", "Índice 1", group=grpS)
sym2 = input.symbol("OANDA:US30USD", "Índice 2", group=grpS)
sym3 = input.symbol("OANDA:NAS100USD", "Índice 3", group=grpS)

grpAl = "Alertas"
testAlert = input.bool(false, "Enviar alerta de prueba", tooltip="Actívalo, crea una alerta con «Cualquier llamada a la función alert()» y espera unos segundos. Si te llega el aviso, las alertas funcionan. Después borra esa alerta y desactívalo.", group=grpAl)

grpV = "Vista"
showMAs   = input.bool(true, "Medias de 200 y 5", group=grpV)
showTable = input.bool(true, "Tabla", group=grpV)
tblPos    = input.string("Abajo a la derecha", "Posición de la tabla", options=["Arriba a la derecha", "Abajo a la derecha", "Abajo a la izquierda", "Arriba a la izquierda"], group=grpV)
extendR   = input.int(5, "Velas a la derecha para las etiquetas", minval=1, maxval=50, group=grpV)

grpC = "Colores"
cTP    = input.color(#22AB94, "TP y señal", group=grpC)
cSL    = input.color(#F23645, "SL", group=grpC)
cEntry = input.color(#2962FF, "Entrada y cabecera", group=grpC)
cMA200 = input.color(#787B86, "Media 200", group=grpC)
cMA5   = input.color(#FF9800, "Media 5 (TP)", group=grpC)
cNow   = input.color(#7E57C2, "Ventana activa", group=grpC)
fillTr = input.int(85, "Transparencia de la caja", minval=0, maxval=100, group=grpC)

// ───────── Cálculo diario
f_daily() =>
    s200 = ta.sma(close, lenTrend)
    s5   = ta.sma(close, lenExit)
    r    = ta.rsi(close, lenRsi)
    a    = ta.atr(lenAtr)
    sig  = close > s200 and r < rsiMax
    bs   = ta.barssince(sig)
    [close, s200, s5, r, a, sig, bs]

[cD, s200D, s5D, rD, aD, sigD, bsD] = request.security(syminfo.tickerid, "D", f_daily())
[c1, t1, e1, r1, a1, g1, b1] = request.security(sym1, "D", f_daily())
[c2, t2, e2, r2, a2, g2, b2] = request.security(sym2, "D", f_daily())
[c3, t3, e3, r3, a3, g3, b3] = request.security(sym3, "D", f_daily())

plot(showMAs ? s200D : na, "Media 200", color=cMA200, linewidth=2)
plot(showMAs ? s5D : na, "Media 5 (TP)", color=cMA5, linewidth=1)

f_px(float v) =>
    str.tostring(v, format.mintick)
f_r(float v) =>
    (v >= 0 ? "+" : "") + str.replace_all(str.tostring(v, "#.0"), ".", ",") + "R"
f_dur(int m) =>
    m >= 60 ? str.tostring(int(m / 60)) + " h " + str.tostring(m % 60) + " min" : str.tostring(m) + " min"

// ───────── Posición en el gráfico (velas cerradas, gráfico diario)
var bool   inPos   = false
var float  ent     = na
var float  stopLvl = na
var int    held    = 0
var box    bxR = na
var line   lE  = na
var line   lS  = na
var line   lT  = na
var label  lbE = na
var label  lbS = na
var label  lbT = na
var string lastTxt = "-"

if barstate.isconfirmed and timeframe.isdaily
    bool exitedNow = false
    if inPos
        held += 1
        bool exStop = low <= stopLvl
        bool exRule = close > s5D
        bool exTime = held >= maxDays
        if exStop or exRule or exTime
            float exitPx = exStop ? stopLvl : close
            float rr = (exitPx - ent) / (ent - stopLvl)
            string why = exStop ? "SL" : exRule ? "TP" : "Tiempo"
            label.new(bar_index, exStop ? low : high, why + " " + f_r(rr), style=exStop ? label.style_label_up : label.style_label_down, color=rr > 0 ? cTP : cSL, textcolor=color.white, size=size.small)
            box.set_right(bxR, bar_index)
            line.set_x2(lE, bar_index)
            line.set_x2(lS, bar_index)
            line.set_xy2(lT, bar_index, line.get_y2(lT))
            label.delete(lbE)
            label.delete(lbS)
            label.delete(lbT)
            lastTxt := why + " " + f_r(rr)
            inPos := false
            exitedNow := true
        else
            int xr = bar_index + extendR
            box.set_right(bxR, xr)
            line.set_x2(lE, xr)
            line.set_x2(lS, xr)
            line.set_xy1(lT, bar_index, s5D)
            line.set_xy2(lT, xr, s5D)
            label.set_x(lbE, xr)
            label.set_x(lbS, xr)
            label.set_xy(lbT, xr, s5D)
            label.set_text(lbT, "TP ≈ " + f_px(s5D) + " (media 5)")
    if not inPos and not exitedNow and sigD
        inPos   := true
        held    := 0
        ent     := close
        stopLvl := close - atrMult * aD
        int xr = bar_index + extendR
        bxR := box.new(bar_index, ent, xr, stopLvl, border_color=color.new(cSL, 60), bgcolor=color.new(cSL, fillTr))
        lE  := line.new(bar_index, ent, xr, ent, color=cEntry, width=2)
        lS  := line.new(bar_index, stopLvl, xr, stopLvl, color=cSL, width=1)
        lT  := line.new(bar_index, s5D, xr, s5D, color=cTP, width=1, style=line.style_dashed)
        lbE := label.new(xr, ent, "Entrada " + f_px(ent), style=label.style_label_left, color=cEntry, textcolor=color.white, size=size.small)
        lbS := label.new(xr, stopLvl, "SL " + f_px(stopLvl) + " · -1R", style=label.style_label_left, color=cSL, textcolor=color.white, size=size.small)
        lbT := label.new(xr, s5D, "TP ≈ " + f_px(s5D) + " (media 5)", style=label.style_label_left, color=cTP, textcolor=color.white, size=size.small)
        label.new(bar_index, low, "A ▲ COMPRA", style=label.style_label_up, color=cTP, textcolor=color.white, size=size.small)
        lastTxt := "COMPRA " + f_px(ent)

// ───────── Hora de Nueva York y ventana
string NY = "America/New_York"
int nowMin  = hour(timenow, NY) * 60 + minute(timenow, NY)
int fromMin = int(winFrom / 100) * 60 + winFrom % 100
int toMin   = int(winTo / 100) * 60 + winTo % 100
int dowNY   = dayofweek(timenow, NY)
bool weekday  = dowNY >= dayofweek.monday and dowNY <= dayofweek.friday
bool inWindow = barstate.isrealtime and weekday and nowMin >= fromMin and nowMin <= toMin
int todayNY = year(timenow, NY) * 10000 + month(timenow, NY) * 100 + dayofmonth(timenow, NY)

// ───────── Alertas del escáner
f_name(string s) =>
    str.replace_all(str.replace_all(s, "OANDA:", ""), "TVC:", "")

f_eval(string s, float c, float t, float e, float r, float a, bool g, int bs, int sentBuy, int sentExit) =>
    string msg = ""
    int nb = sentBuy
    int nx = sentExit
    int since = nz(bs, 9999)
    if inWindow and not na(c)
        if g and sentBuy != todayNY
            msg := "PSF A · COMPRA " + f_name(s) + " · precio " + str.tostring(c, "#.##") + " · stop " + str.tostring(c - atrMult * a, "#.##") + " · RSI(2) " + str.tostring(r, "#.#")
            nb := todayNY
        else if not g and since >= 1 and since <= maxDays and (c > e or since == maxDays) and sentExit != todayNY
            msg := "PSF A · SALIDA " + f_name(s) + (c > e ? " · cierra por encima de la media de 5" : " · séptima sesión, cierre por tiempo") + " · precio " + str.tostring(c, "#.##")
            nx := todayNY
    [msg, nb, nx]

varip int sentB1 = 0
varip int sentX1 = 0
varip int sentB2 = 0
varip int sentX2 = 0
varip int sentB3 = 0
varip int sentX3 = 0

[m1, nb1, nx1] = f_eval(sym1, c1, t1, e1, r1, a1, g1, b1, sentB1, sentX1)
[m2, nb2, nx2] = f_eval(sym2, c2, t2, e2, r2, a2, g2, b2, sentB2, sentX2)
[m3, nb3, nx3] = f_eval(sym3, c3, t3, e3, r3, a3, g3, b3, sentB3, sentX3)
sentB1 := nb1
sentX1 := nx1
sentB2 := nb2
sentX2 := nx2
sentB3 := nb3
sentX3 := nx3
if m1 != ""
    alert(m1, alert.freq_all)
if m2 != ""
    alert(m2, alert.freq_all)
if m3 != ""
    alert(m3, alert.freq_all)
if testAlert and barstate.isrealtime
    alert("PSF A · PRUEBA · si te llega este aviso, las alertas funcionan", alert.freq_once_per_bar)

// ───────── Tabla
string tPos = tblPos == "Arriba a la derecha" ? position.top_right : tblPos == "Abajo a la derecha" ? position.bottom_right : tblPos == "Abajo a la izquierda" ? position.bottom_left : position.top_left
var table tb = table.new(tPos, 4, 6, bgcolor=color.new(chart.bg_color, 0), border_color=color.new(chart.fg_color, 85), border_width=1, frame_color=color.new(chart.fg_color, 70), frame_width=1)
varip bool merged = false

f_row(int row, string s, float c, float t, float r, bool g) =>
    string st = na(c) ? "sin datos" : g ? "SEÑAL" : c > t ? "en tendencia" : "bajo la 200"
    color bg  = g ? cTP : (not na(c) and c <= t) ? color.new(cSL, 80) : color.new(chart.bg_color, 0)
    color tc  = g ? color.white : chart.fg_color
    float pct = (c / t - 1) * 100
    table.cell(tb, 0, row, f_name(s), text_color=chart.fg_color, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, row, na(t) ? "-" : (pct >= 0 ? "+" : "") + str.tostring(pct, "#.0") + "%", text_color=chart.fg_color, text_size=size.small)
    table.cell(tb, 2, row, na(r) ? "-" : str.tostring(r, "#.0"), text_color=chart.fg_color, text_size=size.small)
    table.cell(tb, 3, row, st, text_color=tc, bgcolor=bg, text_size=size.small)

if showTable and barstate.islast
    if not merged
        table.merge_cells(tb, 0, 0, 3, 0)
        table.merge_cells(tb, 0, 1, 3, 1)
        merged := true
    string wTxt = inWindow ? "AHORA: entra o sal antes de las 3:58 pm" : (weekday and nowMin < fromMin) ? "Ventana hoy a las 3:45 pm · en " + f_dur(fromMin - nowMin) : "Próxima ventana: siguiente día laborable, 3:45 pm"
    table.cell(tb, 0, 0, "PSF A · Dip en tendencia · " + (inPos ? "en posición" : "última: " + lastTxt), text_color=color.white, bgcolor=cEntry, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 0, 1, wTxt, text_color=inWindow ? color.white : chart.fg_color, bgcolor=inWindow ? cNow : color.new(chart.bg_color, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 0, 2, "Índice", text_color=chart.fg_color, text_size=size.tiny, text_halign=text.align_left)
    table.cell(tb, 1, 2, "vs 200", text_color=chart.fg_color, text_size=size.tiny)
    table.cell(tb, 2, 2, "RSI(2)", text_color=chart.fg_color, text_size=size.tiny)
    table.cell(tb, 3, 2, "Estado", text_color=chart.fg_color, text_size=size.tiny)
    f_row(3, sym1, c1, t1, r1, g1)
    f_row(4, sym2, c2, t2, r2, g2)
    f_row(5, sym3, c3, t3, r3, g3)
