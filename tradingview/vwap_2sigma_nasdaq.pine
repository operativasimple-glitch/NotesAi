//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// VWAP ±2σ · Reversión a la media en el Nasdaq (NQ / MNQ)
//
// Reglas:
//   • VWAP anclado a la sesión, fuente hlc3, bandas de desviación a 1σ y 2σ.
//   • Compra cuando el cierre cruza hacia abajo la banda inferior 2σ.
//   • Venta cuando el cierre cruza hacia arriba la banda superior 2σ.
//   • Stop a 20 puntos y objetivo a 40 puntos de la entrada.
//   • Al ir 20 puntos a favor (1:1) el stop pasa a la entrada (breakeven).
//   • Momentum: si cierra +20 a favor y el RSI(14) está ≥ 60 (cortos ≤ 40), se quita
//     el objetivo y el stop sigue al precio a 1,5 × ATR(14) del extremo (trailing).
//   • Con momentum se añade 1 contrato cada 20 puntos más a favor (máx. 2), solo si
//     con el stop actual la posición entera no puede cerrar en pérdida.
//
// Gráfico de 2 o 5 minutos en MNQ1! (micro, 2 $/punto) o NQ1! (20 $/punto).
// Alertas: crea una alerta sobre esta estrategia y elige la condición
// "Solo llamadas a la función alert()".
// ─────────────────────────────────────────────────────────────────────────────
// margin_* = 0: los futuros se operan con el margen del broker; con el valor por
// defecto de la v6 (100 %) el probador exigiría el nominal entero y no entraría.
// pyramiding = 5: entrada inicial + hasta 4 añadidos (el límite real lo pone "Máximo de añadidos").
strategy("VWAP ±2σ · Reversión Nasdaq", shorttitle = "VWAP 2σ",
     overlay           = true,
     initial_capital   = 2000,
     default_qty_type  = strategy.fixed,
     default_qty_value = 1,
     pyramiding        = 5,
     commission_type   = strategy.commission.cash_per_contract,
     commission_value  = 0.5,
     slippage          = 1,
     margin_long       = 0,
     margin_short      = 0)

// ───────── Parámetros ─────────
const string NY             = "America/New_York"
const string ANCHOR_SESSION = "Sesión (igual que el VWAP nativo)"
const string ANCHOR_NY      = "Apertura NY 09:30"
const string G_VWAP         = "VWAP"
const string G_RISK         = "Gestión de la orden (puntos)"
const string G_RUN          = "Momentum: dejar correr y añadir"
const string G_TIME         = "Horario"
const string TRAIL_ATR      = "ATR (se adapta a la volatilidad)"
const string TRAIL_POINTS   = "Puntos fijos"

anchorMode = input.string(ANCHOR_SESSION, "Anclaje", options = [ANCHOR_SESSION, ANCHOR_NY], group = G_VWAP, tooltip = "En NQ1!/MNQ1! con horario extendido, 'Sesión' reinicia el VWAP a las 18:00 de Nueva York (apertura de Globex), no a las 09:30. Elige 'Apertura NY 09:30' para que se reinicie con la campana del contado.")
src        = input.source(hlc3, "Fuente", group = G_VWAP)
mult1      = input.float(1.0, "Multiplicador banda 1", minval = 0.1, step = 0.1, group = G_VWAP)
mult2      = input.float(2.0, "Multiplicador banda 2 (señales)", minval = 0.1, step = 0.1, group = G_VWAP)
minBars    = input.int(3, "Ignorar señales en las primeras N velas", minval = 1, group = G_VWAP, tooltip = "Justo después del reinicio las bandas miden casi cero y cualquier movimiento las cruza.")

slPts      = input.float(20.0, "Stop loss", minval = 0.25, step = 1, group = G_RISK)
tpPts      = input.float(40.0, "Objetivo", minval = 0.25, step = 1, group = G_RISK)
useBE      = input.bool(true, "Mover el stop a breakeven", group = G_RISK)
bePts      = input.float(20.0, "Breakeven al ir a favor", minval = 0.25, step = 1, group = G_RISK)
beOffset   = input.float(0.0, "Colchón del breakeven", minval = 0, step = 0.25, group = G_RISK, tooltip = "0 = stop exactamente en la entrada. 1–2 puntos cubren comisiones y deslizamiento.")
allowLong  = input.bool(true, "Operar largos", group = G_RISK)
allowShort = input.bool(true, "Operar cortos", group = G_RISK)

useRunner  = input.bool(true, "Dejar correr si hay momentum", group = G_RUN, tooltip = "Si una vela cierra al menos 'Breakeven al ir a favor' puntos a favor y el RSI confirma, se quita el objetivo fijo y el stop pasa a seguir al precio.")
rsiLen     = input.int(14, "Longitud del RSI", minval = 2, group = G_RUN)
rsiLevel   = input.float(60.0, "Nivel de RSI con momentum", minval = 50.0, maxval = 100.0, step = 1, group = G_RUN, tooltip = "Largos: RSI ≥ este nivel. Cortos: RSI ≤ 100 − este nivel (60 → 40).")
trailMode  = input.string(TRAIL_ATR, "Distancia del trailing", options = [TRAIL_ATR, TRAIL_POINTS], group = G_RUN, tooltip = "ATR: el stop se separa más del precio cuando el Nasdaq se mueve mucho (apertura) y menos cuando está tranquilo.")
atrLen     = input.int(14, "Longitud del ATR", minval = 1, group = G_RUN)
atrMult    = input.float(1.5, "Multiplicador del ATR", minval = 0.1, step = 0.1, group = G_RUN)
trailPts   = input.float(20.0, "Puntos fijos de trailing", minval = 0.25, step = 1, group = G_RUN)
allowAdds  = input.bool(true, "Añadir contratos con momentum", group = G_RUN, tooltip = "Solo añade si, con el stop actual, la posición entera (incluido el nuevo contrato) no puede cerrar en pérdida.")
addStepPts = input.float(20.0, "Añadir cada (puntos más a favor)", minval = 0.25, step = 1, group = G_RUN)
addQty     = input.int(1, "Contratos por añadido", minval = 1, group = G_RUN)
maxAdds    = input.int(2, "Máximo de añadidos", minval = 1, maxval = 4, group = G_RUN)

useWindow  = input.bool(true, "Operar solo dentro del horario", group = G_TIME)
windowSess = input.session("0930-1600", "Horario (hora de Nueva York)", group = G_TIME)
closeAtEnd = input.bool(true, "Cerrar la posición al terminar el horario", group = G_TIME)

// ───────── Comprobaciones ─────────
if timeframe.isdwm
    runtime.error("Usa una temporalidad intradía (2 o 5 minutos).")

var float cumVolume = 0.0
cumVolume += nz(volume)
if barstate.islast and cumVolume == 0
    runtime.error("Este símbolo no trae volumen y el VWAP no se puede calcular. Usa MNQ1! o NQ1!.")

// ───────── VWAP y bandas ─────────
inRTH      = not na(time(timeframe.period, "0930-1600", NY))
nyDay      = dayofmonth(time, NY)
newNYOpen  = inRTH and (not inRTH[1] or nyDay != nyDay[1])
newSession = timeframe.change("D")
anchor     = anchorMode == ANCHOR_NY ? newNYOpen : newSession

[vwapValue, upper1, lower1] = ta.vwap(src, anchor, 1.0)
stdev = (upper1 - lower1) / 2
up1   = vwapValue + stdev * mult1
lo1   = vwapValue - stdev * mult1
up2   = vwapValue + stdev * mult2
lo2   = vwapValue - stdev * mult2

var int barsSinceAnchor = 0
barsSinceAnchor := anchor ? 0 : barsSinceAnchor + 1
bandsReady = barsSinceAnchor >= minBars

rsiValue  = ta.rsi(close, rsiLen)
atrValue  = ta.atr(atrLen)
trailDist = trailMode == TRAIL_ATR ? atrMult * atrValue : trailPts

// ───────── Horario ─────────
inWindowRaw   = not na(time(timeframe.period, windowSess, NY))
endHour       = int(str.tonumber(str.substring(windowSess, 5, 7)))
endMinute     = int(str.tonumber(str.substring(windowSess, 7, 9)))
windowEnd     = timestamp(NY, year(time, NY), month(time, NY), dayofmonth(time, NY), endHour, endMinute)
lastWindowBar = inWindowRaw and time_close >= windowEnd
inWindow      = not useWindow or inWindowRaw
// Una orden enviada en la última vela del horario se llenaría ya fuera de él.
canEnter      = inWindow and not (useWindow and lastWindowBar)

// ───────── Señales ─────────
crossDown2  = ta.crossunder(close, lo2)
crossUp2    = ta.crossover(close, up2)
longSignal  = allowLong and bandsReady and canEnter and crossDown2
shortSignal = allowShort and bandsReady and canEnter and crossUp2

// ───────── Posición ─────────
// El stop solo se mueve a favor: nunca se aleja del precio.
ratchet(float current, float candidate, int d) =>
    na(current) ? candidate : d > 0 ? math.max(current, candidate) : math.min(current, candidate)

isLong      = strategy.position_size > 0
isShort     = strategy.position_size < 0
inTrade     = isLong or isShort
dir         = isLong ? 1 : isShort ? -1 : 0
firstPx     = inTrade ? strategy.opentrades.entry_price(0) : na
avgPx       = strategy.position_avg_price
posQty      = math.abs(strategy.position_size)
baseId      = isLong ? "Largo" : "Corto"
momentumNow = isLong ? rsiValue >= rsiLevel : isShort ? rsiValue <= 100 - rsiLevel : false

// Un único stop (stopPx) para toda la posición, referido al precio de la primera entrada.
var bool  beActive  = false
var bool  runActive = false
var float extreme   = na
var float stopPx    = na
var float addRef    = na
var int   addsDone  = 0
runStarted = false

if not inTrade
    beActive  := false
    runActive := false
    extreme   := na
    stopPx    := na
    addRef    := na
    addsDone  := 0
else
    prevStop = stopPx
    extreme := na(extreme) ? (isLong ? high : low) : isLong ? math.max(extreme, high) : math.min(extreme, low)
    if na(stopPx)
        stopPx := firstPx - dir * slPts
        addRef := firstPx

    if useBE and not beActive and dir * (extreme - firstPx) >= bePts
        beActive := true
        stopPx   := ratchet(stopPx, firstPx + dir * beOffset, dir)
        alert("BREAKEVEN " + syminfo.ticker + ": +" + str.tostring(bePts) + " pts a favor. Mueve el stop a " + str.tostring(stopPx, format.mintick), alert.freq_once_per_bar_close)

    if useRunner and not runActive and momentumNow and dir * (close - firstPx) >= bePts
        runActive  := true
        runStarted := true
    if runActive
        stopPx := ratchet(stopPx, math.round_to_mintick(extreme - dir * trailDist), dir)

    if runStarted
        alert("MOMENTUM " + syminfo.ticker + ": deja correr. Quita el objetivo; stop a " + str.tostring(trailDist, format.mintick) + " pts del extremo, ahora en " + str.tostring(stopPx, format.mintick), alert.freq_once_per_bar_close)
    else if runActive and stopPx != prevStop
        alert("TRAILING " + syminfo.ticker + ": mueve el stop a " + str.tostring(stopPx, format.mintick), alert.freq_once_per_bar_close)

if useWindow and closeAtEnd and inTrade and (lastWindowBar or not inWindowRaw)
    strategy.close_all(comment = "Fin de horario", immediately = true)
    alert("CIERRA " + syminfo.ticker + ": fin del horario operativo.", alert.freq_once_per_bar_close)

// ───────── Añadir contratos ─────────
if inTrade and runActive and allowAdds and addsDone < maxAdds and canEnter and momentumNow and dir * (close - addRef) >= addStepPts
    // Resultado si salta el stop justo después de añadir (sin comisiones ni deslizamiento).
    worstAtStop = dir * (stopPx - avgPx) * posQty + dir * (stopPx - close) * addQty
    if worstAtStop >= 0
        addsDone += 1
        addRef   := close
        strategy.entry(baseId + " +" + str.tostring(addsDone), isLong ? strategy.long : strategy.short, qty = addQty)
        alert("AÑADE " + str.tostring(addQty) + " contrato(s) " + (isLong ? "largo" : "corto") + " en " + syminfo.ticker + " ~" + str.tostring(close, format.mintick) + ". Stop de toda la posición: " + str.tostring(stopPx, format.mintick), alert.freq_once_per_bar_close)

// ───────── Entradas ─────────
if not inTrade and longSignal
    strategy.entry("Largo", strategy.long)
    alert("COMPRA " + syminfo.ticker + " ~" + str.tostring(close, format.mintick) + " (cierre bajo la banda -2σ) · SL " + str.tostring(close - slPts, format.mintick) + " · TP " + str.tostring(close + tpPts, format.mintick) + " · BE en " + str.tostring(close + bePts, format.mintick), alert.freq_once_per_bar_close)

if not inTrade and shortSignal
    strategy.entry("Corto", strategy.short)
    alert("VENTA " + syminfo.ticker + " ~" + str.tostring(close, format.mintick) + " (cierre sobre la banda +2σ) · SL " + str.tostring(close + slPts, format.mintick) + " · TP " + str.tostring(close - tpPts, format.mintick) + " · BE en " + str.tostring(close - bePts, format.mintick), alert.freq_once_per_bar_close)

// ───────── Salidas ─────────
slTicks = math.round(slPts / syminfo.mintick)
tpTicks = math.round(tpPts / syminfo.mintick)

if not inTrade
    // Entrada pendiente: stop y objetivo en ticks desde el precio real de llenado.
    strategy.exit("Salida Largo", "Largo", profit = tpTicks, loss = slTicks, comment_profit = "TP", comment_loss = "SL")
    strategy.exit("Salida Corto", "Corto", profit = tpTicks, loss = slTicks, comment_profit = "TP", comment_loss = "SL")
else
    // Mismo stop para la entrada y los añadidos; con momentum no hay objetivo fijo.
    targetPx = runActive ? na : firstPx + dir * tpPts
    stopTag  = runActive ? "Trailing" : beActive ? "BE" : "SL"
    strategy.exit("Salida " + baseId, baseId, stop = stopPx, limit = targetPx, comment_profit = "TP", comment_loss = stopTag)
    if addsDone > 0
        for i = 1 to addsDone
            addId = baseId + " +" + str.tostring(i)
            strategy.exit("Salida " + addId, addId, stop = stopPx, limit = targetPx, comment_profit = "TP", comment_loss = stopTag)

// ───────── Gráfico ─────────
// Color na en la vela de anclaje para no dibujar el salto entre una sesión y la siguiente.
cVwap  = anchor ? na : #2962FF
cBand1 = anchor ? na : #4CAF50
cBand2 = anchor ? na : #808000

plot(vwapValue, "VWAP", color = cVwap, linewidth = 2)
pUp1 = plot(up1, "Banda superior 1σ", color = cBand1)
pLo1 = plot(lo1, "Banda inferior 1σ", color = cBand1)
pUp2 = plot(up2, "Banda superior 2σ", color = cBand2)
pLo2 = plot(lo2, "Banda inferior 2σ", color = cBand2)
fill(pUp1, pLo1, color = color.new(#4CAF50, 94), title = "Fondo banda 1")
fill(pUp2, pUp1, color = color.new(#808000, 94), title = "Fondo banda 2 superior")
fill(pLo1, pLo2, color = color.new(#808000, 94), title = "Fondo banda 2 inferior")

plotshape(longSignal, "Señal de compra", style = shape.triangleup, location = location.belowbar, color = #26A69A, size = size.small)
plotshape(shortSignal, "Señal de venta", style = shape.triangledown, location = location.abovebar, color = #EF5350, size = size.small)
plotshape(runStarted and isLong, "Momentum en largo", style = shape.diamond, location = location.belowbar, color = #FFB300, size = size.tiny)
plotshape(runStarted and isShort, "Momentum en corto", style = shape.diamond, location = location.abovebar, color = #FFB300, size = size.tiny)

plot(inTrade ? avgPx : na, "Precio medio", color = color.gray, style = plot.style_linebr)
plot(inTrade ? stopPx : na, "Stop", color = #EF5350, style = plot.style_linebr)
plot(inTrade and not runActive ? firstPx + dir * tpPts : na, "Objetivo", color = #26A69A, style = plot.style_linebr)
